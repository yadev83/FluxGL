{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "scripts/configure.sh Debug",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "cmake --build build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "configure release",
            "type": "shell",
            "command": "scripts/configure.sh Release"
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "cmake --build build/Release"
            ],
            "group": "build"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "scripts/clean.sh",
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
